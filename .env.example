# EmailJS — the contact letter (src/api.ts). Copy to .env.local and fill in; on Vercel add the same three
# variables in Project Settings → Environment Variables. All three come from https://dashboard.emailjs.com
#   Service ID  → Email Services (e.g. your Gmail)
#   Template ID → Email Templates; the template uses {{from_name}}, {{reply_to}}, {{message}}, {{date}}
#                 and should set "Reply To" = {{reply_to}}
#   Public key  → Account → General
# SUBSTITUIR EM PRODUÇÃO: restrinja os domínios permitidos e ative o reCAPTCHA no painel do EmailJS.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
